# Containerfile.praxis - Praxis proxy built WITH the llm_d_sc filter crate.
#
# Modelled on ~/praxis/Containerfile, which already solves this build. Two
# deliberate divergences from that file, both forced by the build environment:
#
#   1. No `# syntax=docker/dockerfile:1` directive and no `RUN --mount=type=cache`.
#      Those are BuildKit features. This image is built by an OpenShift Docker-
#      strategy BuildConfig, which uses buildah. A binary build starts from a
#      fresh pod every time, so the cache mounts would buy nothing even where
#      they parse.
#   2. No dependency-stub pre-build layer. That trick exists to keep a *cached*
#      dependency layer warm across rebuilds. With no cross-build cache it only
#      adds a redundant compile of the dependency graph.
#
# Everything that matters is kept: the rust:1.96-alpine builder matching
# rust-toolchain.toml (channel = "1.96.0"), static OpenSSL against musl, the same
# apk toolchain, a minimal alpine runtime, and a non-root entrypoint.
#
# Build context layout (produced by hack/stage-build-context.sh):
#   ./praxis/                   the Praxis workspace
#   ./llm-d-sc-praxis-filter/   this crate
#   ./Containerfile.praxis      this file
#
# Build:
#   CTX="$(hack/stage-build-context.sh)"
#   oc start-build praxis-llm-d-sc -n praxis-poc --from-dir="$CTX" --follow

# ------------------------------------------------------------------------------
# Stage 1: Build
# ------------------------------------------------------------------------------

FROM rust:1.96-alpine AS builder

# Static OpenSSL: the runtime stage is a bare alpine with no openssl runtime.
ENV OPENSSL_STATIC=1
# prost-build ships a vendored protoc built against glibc, which cannot execute
# on musl. Point it at alpine's native protoc instead.
ENV PROTOC=/usr/bin/protoc

RUN apk add --no-cache \
      musl-dev \
      openssl-dev \
      openssl-libs-static \
      pkgconf \
      cmake \
      make \
      g++ \
      perl \
      protobuf \
      protobuf-dev

WORKDIR /src

COPY praxis/                  /src/praxis/
COPY llm-d-sc-praxis-filter/  /src/llm-d-sc-praxis-filter/

# --- Use the staged Praxis workspace for the filter dependencies ---------------
#
# Keep this image-only: the source manifests remain unchanged in the repository.
# The append is idempotent because an existing workspace patch is left alone.
RUN set -e; \
    if ! grep -q '^\[patch\."https://github\.com/praxis-proxy/praxis"\]$' /src/praxis/Cargo.toml; then \
      printf '%s\n' '' '[patch."https://github.com/praxis-proxy/praxis"]' \
        'praxis-proxy-core = { path = "core" }' \
        'praxis-proxy-filter = { path = "filter" }' \
        >> /src/praxis/Cargo.toml; \
    fi

RUN grep -q '^\[patch\."https://github\.com/praxis-proxy/praxis"\]$' /src/praxis/Cargo.toml

RUN set -e; \
    if ! grep -q '^llm-d-sc-praxis-filter[[:space:]]*=' /src/praxis/server/Cargo.toml; then \
      sed -i '/^\[dependencies\]$/a llm-d-sc-praxis-filter = { path = "/src/llm-d-sc-praxis-filter" }' /src/praxis/server/Cargo.toml; \
    fi

WORKDIR /src/praxis

# Lower this if the build pod is OOM-killed (SPEC-K8S 4). Never switch to a debug
# build to save memory: every benchmark latency figure depends on --release.
# An ARG with no default expands to the EMPTY STRING when no --build-arg is
# passed, and `CARGO_BUILD_JOBS=` is a hard cargo error ("Number of parallel jobs
# should be `default` or a number"), not an ignored value. So the default is
# spelled out. `default` means "one job per CPU", which is what an unset
# CARGO_BUILD_JOBS would have meant; lower it via --build-arg if the builder pod
# gets OOM-killed during codegen.
ARG CARGO_BUILD_JOBS=default
ENV CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS}

RUN cargo build --release -p praxis-proxy \
 && cp target/release/praxis /usr/local/bin/praxis

# Prove the filter is actually registered, at build time rather than at rollout.
# `--validate` runs the real startup path (filter factory construction, chain
# expansion, ordering and cluster-alignment checks) and exits. If `llm_d_sc` were
# missing from the registry, or if its config schema disagreed with the config we
# are about to ship, this fails the build instead of CrashLoopBackOff-ing later.
# It performs no DNS and no network I/O: cluster endpoints are stored as strings
# and resolved per-connection, and the filter's gRPC channel is connect_lazy.
RUN /usr/local/bin/praxis --validate \
      -c /src/llm-d-sc-praxis-filter/deploy/config/praxis-config.yaml \
 && echo "OK: llm_d_sc filter is registered and the shipped config validates"

# ------------------------------------------------------------------------------
# Stage 2: Runtime
# ------------------------------------------------------------------------------

FROM alpine:3.23

LABEL org.opencontainers.image.title="praxis-llm-d-sc" \
      org.opencontainers.image.description="Praxis proxy with the llm_d_sc semantic-classification routing filter" \
      org.opencontainers.image.licenses="MIT"

# OpenShift runs containers with an arbitrary, per-namespace UID and GID 0. So:
#   - nothing may assume uid 0 or uid 1001 specifically;
#   - every path the process must read or write is owned by group 0 and made
#     group-writable (`chmod g=u`), because GID 0 is the one identity guaranteed
#     to be present.
# /etc/praxis is where the initContainer writes the rendered config (a memory
# emptyDir at runtime); /config-template is where the ConfigMap is mounted.
RUN apk add --no-cache ca-certificates \
 && mkdir -p /etc/praxis /config-template \
 && chgrp -R 0 /etc/praxis /config-template \
 && chmod -R g=u /etc/praxis /config-template

COPY --from=builder --chown=root:root --chmod=0555 \
     /usr/local/bin/praxis /usr/local/bin/praxis

# Renders the ConfigMap template into /etc/praxis/config.yaml, substituting the
# ds4 bearer token from the environment. Run as the initContainer's command.
COPY --chown=root:root --chmod=0555 \
     llm-d-sc-praxis-filter/deploy/runtime/render-config.sh \
     /usr/local/bin/render-config.sh

# Numeric, and only a placeholder: OpenShift overrides it with the namespace's
# assigned UID. Its real job is to guarantee the image never defaults to root.
USER 1001

WORKDIR /etc/praxis

# 8080 data plane, 9901 admin (/healthy, /ready, /metrics).
EXPOSE 8080 9901

ENTRYPOINT ["/usr/local/bin/praxis", "-c", "/etc/praxis/config.yaml"]
